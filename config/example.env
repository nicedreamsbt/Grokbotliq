DRY_RUN=true
LIQ_CONFIG=config/example.toml
# Prefer comma-separated rotation pool (gitignored config/local.env for real keys):
# RPC_URLS=https://YOUR_RPC_HOST_1/PATH_OR_QUERY,https://YOUR_RPC_HOST_2/PATH_OR_QUERY
RPC_URL=https://YOUR_PRIVATE_RPC
# LIQ_MAINNET_SHADOW=1
# GEYSER_ENDPOINT=https://YOUR_GEYSER_GRPC
# GEYSER_X_TOKEN=YOUR_TOKEN
# GEYSER_COMMITMENT=processed
# JITO_BLOCK_ENGINE_URL=https://YOUR_JITO_BLOCK_ENGINE
# JITO_AUTH_UUID=
# KEYPAIR_PATH=./keys/liquidator.json
# LIQ_FIXTURES=fixtures
RUST_LOG=info,liq_execution=debug
